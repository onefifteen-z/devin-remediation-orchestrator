DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_LIVE_ENABLED=false

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

DATABASE_URL=sqlite:///./data/app.db

MAX_ACTIVE_SESSIONS=3
MAX_RETRIES=3

DEVIN_SESSION_TIMEOUT_MINUTES=60

MAX_ACU_PER_TASK=
DAILY_ACU_CAP=

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

GITHUB_SCAN_REPOSITORIES=owner/superset
REMEDIATE_LABEL=devin-remediate

DEVIN_SESSION_POLL_INTERVAL_SECONDS=15
DEVIN_POLL_MAX_FAILURES=10

# GITHUB_TOKEN: Orchestrator -> GitHub REST API (issue comment/close, PR fetch, manual scan)
# GITHUB_WEBHOOK_SECRET: GitHub -> Orchestrator webhook HMAC verification (separate from GITHUB_TOKEN)

# Phase 5: Advanced Devin integration (all optional)
DEVIN_REMEDIATION_PLAYBOOK_ID=

DEVIN_SCHEDULED_ENABLED=false
DEVIN_SCHEDULE_CRON=0 9 * * 1-5
DEVIN_SCHEDULE_ID=
ORCHESTRATOR_PUBLIC_URL=
SCHEDULED_INTAKE_TOKEN=
